parameters:
    tmpDir: .cache/phpstan

    paths:
        - src
        - tests

    level: max

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        # Pest's test API is not statically expressible: inside a closure
        # PHPStan resolves $this to TestCall rather than the TestCase, so
        # $this->artisan() and friends look undefined, and expect() chains
        # return mixed. These are the shape of the framework, not defects —
        # the same set laranail/validation carries.
        - identifier: method.notFound
          path: tests/
          reportUnmatched: false
        - identifier: method.nonObject
          path: tests/
          reportUnmatched: false
        - identifier: property.notFound
          path: tests/
          reportUnmatched: false
        - identifier: offsetAccess.nonOffsetAccessible
          path: tests/
          reportUnmatched: false
        - identifier: argument.type
          path: tests/
          reportUnmatched: false
        # The macro closure's $this is rebound to the PasswordRule node at
        # call time (Macroable). Whether larastan reports anything here
        # depends on which laranail/validation line the dual dev range
        # resolved, so the ignore must tolerate absence.
        - identifier: method.notFound
          path: src/Providers/PasswordHistoryServiceProvider.php
          reportUnmatched: false
